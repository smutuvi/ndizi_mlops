{
  "project": "Ndizi-Swahili-w2vbert",
  "output_dir": "inprogress/ndizi-w2vbert-2025-only",
  "seed": 42,
  "pretrained_model": "facebook/wav2vec2-bert-rel-pos-large",
  "freeze_feature_encoder": false,
  "batch_size": 4,
  "per_device_eval_batch_size": 4,
  "gradient_accumulation_steps": 4,
  "num_train_epochs": 10.0,
  "learning_rate": 0.0001,
  "warmup_steps": 500,
  "weight_decay": 0.0,
  "fp16": true,
  "bf16": false,
  "gradient_checkpointing": true,
  "group_by_length": true,
  "eval_strategy": "epoch",
  "eval_steps": 500,
  "logging_steps": 50,
  "save_total_limit": 2,
  "max_input_seconds": 30.0,
  "normalize_wer": false,
  "train_datasets": [
    "smutuvi/ndizi-1-2025"
  ],
  "train_splits": [
    "train"
  ],
  "push_to_hub": false,
  "use_hub_ctc_checkpoint": true,
  "format_transcripts": true,
  "normalize_oral_tokens": false,
  "lowercase_ctc_labels": true,
  "character_set": "abcdefghijklmnopqrstuvwxyz0123456789 .,?!-':/%()"
}
