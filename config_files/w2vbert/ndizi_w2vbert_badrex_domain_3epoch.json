{
  "project": "Ndizi-W2VBERT-Badrex-Domain-3Epoch",
  "output_dir": "inprogress/ndizi-w2vbert-badrex-domain-3epoch",
  "seed": 42,
  "pretrained_model": "badrex/w2v-bert-2.0-swahili-asr",
  "use_hub_ctc_checkpoint": true,
  "freeze_feature_encoder": true,
  "add_final_layer_adapter": false,
  "trainable_scope": "full",
  "format_transcripts": true,
  "normalize_oral_tokens": true,
  "enrich_discourse_punctuation": false,
  "apply_accent_replacements": true,
  "sample": false,
  "batch_size": 4,
  "per_device_eval_batch_size": 4,
  "gradient_accumulation_steps": 4,
  "num_train_epochs": 3.0,
  "learning_rate": 3e-05,
  "warmup_steps": 150,
  "weight_decay": 0.0,
  "fp16": true,
  "bf16": false,
  "gradient_checkpointing": true,
  "group_by_length": true,
  "eval_strategy": "epoch",
  "early_stopping_patience": 1,
  "logging_steps": 50,
  "save_total_limit": 2,
  "max_input_seconds": 30.0,
  "normalize_wer": false,
  "apply_data_qc": true,
  "qc_use_may6_text_norm": true,
  "qc_allow_sentence_punctuation": true,
  "train_datasets": ["smutuvi/ndizi-1", "smutuvi/ndizi-1-2025"],
  "train_splits": ["train", "train"],
  "eval_datasets": ["smutuvi/ndizi-1", "smutuvi/ndizi-1-2025"],
  "eval_splits": ["validation", "validation"],
  "push_to_hub": false
}
