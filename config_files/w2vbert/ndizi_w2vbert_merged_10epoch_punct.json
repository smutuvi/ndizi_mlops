{
  "project": "Ndizi-W2VBERT-Merged-10Epoch-Punct",
  "output_dir": "inprogress/ndizi-w2vbert-merged-10epoch-punct",
  "seed": 42,
  "pretrained_model": "facebook/w2v-bert-2.0",
  "freeze_feature_encoder": true,
  "add_final_layer_adapter": true,
  "use_hub_ctc_checkpoint": false,
  "character_set": "abcdefghijklmnopqrstuvwxyz0123456789 .,?!-':/%()",
  "format_transcripts": true,
  "normalize_oral_tokens": true,
  "enrich_discourse_punctuation": true,
  "lowercase_ctc_labels": true,
  "use_formatting_score_for_best": true,
  "batch_size": 4,
  "per_device_eval_batch_size": 4,
  "gradient_accumulation_steps": 4,
  "num_train_epochs": 10.0,
  "learning_rate": 3e-05,
  "warmup_steps": 500,
  "weight_decay": 0.0,
  "fp16": true,
  "gradient_checkpointing": true,
  "group_by_length": true,
  "eval_strategy": "epoch",
  "logging_steps": 50,
  "save_total_limit": 2,
  "max_input_seconds": null,
  "apply_data_qc": true,
  "qc_use_may6_text_norm": true,
  "qc_allow_sentence_punctuation": true,
  "qc_chunk_long_with_mms_fa": false,
  "qc_max_dur": 75.0,
  "train_datasets": ["smutuvi/ndizi-1", "smutuvi/ndizi-1-2025"],
  "train_splits": ["train", "train"],
  "push_to_hub": false
}
