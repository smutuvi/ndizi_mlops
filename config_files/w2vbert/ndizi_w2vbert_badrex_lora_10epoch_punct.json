{
  "project": "Ndizi-W2VBERT-Badrex-LoRA-10Epoch-Punct",
  "output_dir": "inprogress/ndizi-w2vbert-badrex-lora-10epoch-punct",
  "seed": 42,
  "pretrained_model": "badrex/w2v-bert-2.0-swahili-asr",
  "freeze_feature_encoder": true,
  "add_final_layer_adapter": true,
  "use_hub_ctc_checkpoint": false,
  "trainable_scope": "lora",
  "lora_r": 32,
  "lora_alpha": 64,
  "lora_dropout": 0.05,
  "lora_target_modules": null,
  "character_set": "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789 .,?!-':/%()",
  "format_transcripts": true,
  "normalize_oral_tokens": true,
  "enrich_discourse_punctuation": true,
  "mms_fa_chunk_terminal_period": true,
  "lowercase_ctc_labels": false,
  "use_formatting_score_for_best": true,
  "sample": false,
  "batch_size": 4,
  "per_device_eval_batch_size": 4,
  "gradient_accumulation_steps": 4,
  "num_train_epochs": 10.0,
  "learning_rate": 1e-05,
  "warmup_steps": 500,
  "weight_decay": 0.0,
  "fp16": true,
  "bf16": false,
  "gradient_checkpointing": true,
  "group_by_length": true,
  "eval_strategy": "epoch",
  "logging_steps": 50,
  "save_total_limit": 2,
  "max_input_seconds": null,
  "normalize_wer": false,
  "apply_data_qc": true,
  "qc_use_may6_text_norm": true,
  "qc_allow_sentence_punctuation": true,
  "qc_chunk_long_with_mms_fa": true,
  "qc_chunk_long_with_mms_fa_eval": true,
  "qc_chunk_seconds": 30.0,
  "qc_fa_device": "auto",
  "qc_max_dur": 75.0,
  "train_datasets": ["smutuvi/ndizi-1", "smutuvi/ndizi-1-2025"],
  "train_splits": ["train", "train"],
  "eval_datasets": ["smutuvi/ndizi-1", "smutuvi/ndizi-1-2025"],
  "eval_splits": ["validation", "validation"],
  "push_to_hub": false
}
