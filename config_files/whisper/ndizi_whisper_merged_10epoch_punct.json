{
  "stack": "whisper",
  "project": "Ndizi-Whisper-Merged-10Epoch-Punct",
  "output_dir": "runs/ndizi-whisper-merged-10epoch-punct",
  "seed": 42,
  "pretrained_model": "openai/whisper-large-v3-turbo",
  "whisper_language": "sw",
  "whisper_task": "transcribe",
  "generation_max_length": 444,
  "generation_num_beams": 1,
  "batch_size": 1,
  "per_device_eval_batch_size": 1,
  "gradient_accumulation_steps": 8,
  "num_train_epochs": 10.0,
  "learning_rate": 1e-05,
  "warmup_steps": 500,
  "weight_decay": 0.0,
  "fp16": true,
  "gradient_checkpointing": true,
  "group_by_length": true,
  "eval_strategy": "epoch",
  "logging_steps": 50,
  "save_total_limit": 2,
  "early_stopping_patience": 3,
  "max_input_seconds": null,
  "normalize_wer": false,
  "format_transcripts": true,
  "normalize_oral_tokens": true,
  "enrich_discourse_punctuation": true,
  "mms_fa_chunk_terminal_period": true,
  "use_formatting_score_for_best": true,
  "apply_data_qc": true,
  "qc_use_may6_text_norm": true,
  "qc_allow_sentence_punctuation": true,
  "qc_chunk_long_with_mms_fa": true,
  "qc_chunk_long_with_mms_fa_eval": true,
  "qc_chunk_seconds": 30.0,
  "qc_fa_device": "auto",
  "train_datasets": ["smutuvi/ndizi-1", "smutuvi/ndizi-1-2025"],
  "train_splits": ["train", "train"],
  "push_to_hub": false
}
